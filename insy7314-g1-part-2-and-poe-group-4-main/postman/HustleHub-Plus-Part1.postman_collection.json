  "item": [
    {
      "name": "01. Health and Server Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response returns status OK\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"OK\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02. Security Headers Verification",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Content-Security-Policy header is present\", function () {",
              "    pm.expect(pm.response.headers.has(\"Content-Security-Policy\")).to.be.true;",
              "});",
              "pm.test(\"X-Content-Type-Options header is nosniff\", function () {",
              "    pm.expect(pm.response.headers.has(\"X-Content-Type-Options\")).to.be.true;",
              "});",
              "pm.test(\"X-Powered-By header is stripped\", function () {",
              "    pm.expect(pm.response.headers.has(\"X-Powered-By\")).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03. User Registration - Success (Freelancer)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueTimestamp = Date.now();",
              "pm.environment.set(\"testUserEmail\", `freelancer_${uniqueTimestamp}@example.com`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"JWT Token is returned\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.a(\"string\");",
              "    pm.environment.set(\"token\", jsonData.token);",
              "});",
              "pm.test(\"Password hash is NOT exposed in response\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.passwordHash).to.be.undefined;",
              "    pm.expect(jsonData.data.password).to.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Alex Rivera\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"ComplexPass2026!\",\n  \"role\": \"freelancer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
