							"raw": "{\n  \"fullName\": \"Thabo Mokoena\",\n  \"email\": \"thabo.client.{{$randomInt}}@example.com\",\n  \"password\": \"P@ssword2026!Secure\",\n  \"role\": \"client\"\n}"
